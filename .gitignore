# Build trees (CMake presets put everything under build/)
build/
compile_commands.json
.cache/

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/

# Scratch output from tools/run-oracle.sh and local experiments
*.log
/work/

# Editors
.vscode/
*.swp

# ABC writes its command history to the working directory
abc.history

# Generated by docs/user/_ext/passes_ref.py at docs build time
docs/user/_generated/

# Per-user permission overrides (controller keeps machine-specific rules here)
.claude/settings.local.json

# Scratch BLIFs of test_lower_corpus run by hand
/lower_reverse_*.blif
