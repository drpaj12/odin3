# The same 2-bit adder built from two instances of a user-defined full-adder model.
# The net `t` inside `fa` must be kept apart per instance when flattening.
.model add2
.inputs a[0] a[1] b[0] b[1]
.outputs s[0] s[1] s[2]
.names zero
.subckt fa x=a[0] y=b[0] ci=zero s=s[0] co=c0
.subckt fa x=a[1] y=b[1] ci=c0 s=s[1] co=s[2]
.end

.model fa
.inputs x y ci
.outputs s co
.names x y t
10 1
01 1
.names t ci s
10 1
01 1
.names x y ci co
11- 1
1-1 1
-11 1
.end
