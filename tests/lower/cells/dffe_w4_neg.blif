.model m
.inputs clk en d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_NOT_ A=clk Y=$n20
.cname q.not0
.subckt $_MUX_ A=q[0] B=d[0] S=en Y=$n22
.cname q.mux1
.latch $n22 q[0] re $n20 3
.cname q.dff_p2
.subckt $_MUX_ A=q[1] B=d[1] S=en Y=$n24
.cname q.mux3
.latch $n24 q[1] re $n20 3
.cname q.dff_p4
.subckt $_MUX_ A=q[2] B=d[2] S=en Y=$n26
.cname q.mux5
.latch $n26 q[2] re $n20 3
.cname q.dff_p6
.subckt $_MUX_ A=q[3] B=d[3] S=en Y=$n28
.cname q.mux7
.latch $n28 q[3] re $n20 3
.cname q.dff_p8
.end
