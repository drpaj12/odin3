.model m
.inputs clk set clr d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_NOT_ A=clk Y=$n62
.cname q.not0
.subckt $_MUX_ A=d[0] B=vcc S=$n83 Y=$n64
