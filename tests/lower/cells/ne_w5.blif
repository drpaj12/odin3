.model m
.inputs a[0] a[1] a[2] a[3] a[4] b[0] b[1] b[2] b[3] b[4]
.outputs y
.subckt $_XOR_ A=a[0] B=b[0] Y=$n12
.subckt $_XOR_ A=a[1] B=b[1] Y=$n13
.subckt $_XOR_ A=a[2] B=b[2] Y=$n14
.subckt $_XOR_ A=a[3] B=b[3] Y=$n15
.subckt $_XOR_ A=a[4] B=b[4] Y=$n16
.subckt $_OR_ A=$n12 B=$n13 Y=$n17
.subckt $_OR_ A=$n14 B=$n15 Y=$n18
.subckt $_OR_ A=$n17 B=$n18 Y=$n19
.subckt $_OR_ A=$n19 B=$n16 Y=y
.end
