.model m
.inputs a[0] a[1] a[2] a[3] a[4] b0[0] b0[1] b0[2] b0[3] b0[4] b1[0] b1[1] b1[2] b1[3] b1[4] s[0] \
  s[1]
.outputs y[0] y[1] y[2] y[3] y[4]
.subckt $_OR_ A=s[1] B=s[0] Y=$n41
.subckt $_AND_ A=b1[0] B=s[1] Y=$n42
.subckt $_AND_ A=b0[0] B=s[0] Y=$n43
.subckt $_OR_ A=$n42 B=$n43 Y=$n44
.subckt $_MUX_ A=a[0] B=$n44 S=$n41 Y=y[0]
.subckt $_AND_ A=b1[1] B=s[1] Y=$n46
.subckt $_AND_ A=b0[1] B=s[0] Y=$n47
.subckt $_OR_ A=$n46 B=$n47 Y=$n48
.subckt $_MUX_ A=a[1] B=$n48 S=$n41 Y=y[1]
.subckt $_AND_ A=b1[2] B=s[1] Y=$n50
.subckt $_AND_ A=b0[2] B=s[0] Y=$n51
.subckt $_OR_ A=$n50 B=$n51 Y=$n52
.subckt $_MUX_ A=a[2] B=$n52 S=$n41 Y=y[2]
.subckt $_AND_ A=b1[3] B=s[1] Y=$n54
.subckt $_AND_ A=b0[3] B=s[0] Y=$n55
.subckt $_OR_ A=$n54 B=$n55 Y=$n56
.subckt $_MUX_ A=a[3] B=$n56 S=$n41 Y=y[3]
.subckt $_AND_ A=b1[4] B=s[1] Y=$n58
.subckt $_AND_ A=b0[4] B=s[0] Y=$n59
.subckt $_OR_ A=$n58 B=$n59 Y=$n60
.subckt $_MUX_ A=a[4] B=$n60 S=$n41 Y=y[4]
.end
