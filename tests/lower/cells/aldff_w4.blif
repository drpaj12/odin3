.model m
.inputs clk ld ad[0] ad[1] ad[2] ad[3] d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_MUX_ A=d[0] B=ad[0] S=ld Y=$n22
.cname q.mux0
.latch $n22 q[0] re clk 3
.cname q.dff_p1
.subckt $_MUX_ A=d[1] B=ad[1] S=ld Y=$n24
.cname q.mux2
.latch $n24 q[1] re clk 3
.cname q.dff_p3
.subckt $_MUX_ A=d[2] B=ad[2] S=ld Y=$n26
.cname q.mux4
.latch $n26 q[2] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=d[3] B=ad[3] S=ld Y=$n28
.cname q.mux6
.latch $n28 q[3] re clk 3
.cname q.dff_p7
.end
