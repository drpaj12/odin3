.model m
.inputs clk rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_NOT_ A=clk Y=$n24
.cname q.not0
.subckt $_MUX_ A=vcc B=d[0] S=rst Y=$n27
.cname q.mux1
.latch $n27 q[0] re $n24 3
.cname q.dff_p2
.subckt $_MUX_ A=gnd B=d[1] S=rst Y=$n30
.cname q.mux3
.latch $n30 q[1] re $n24 3
.cname q.dff_p4
.subckt $_MUX_ A=vcc B=d[2] S=rst Y=$n32
.cname q.mux5
.latch $n32 q[2] re $n24 3
.cname q.dff_p6
.subckt $_MUX_ A=gnd B=d[3] S=rst Y=$n34
.cname q.mux7
.latch $n34 q[3] re $n24 3
.cname q.dff_p8
.end
