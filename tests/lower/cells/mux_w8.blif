.model m
.inputs a[0] a[1] a[2] a[3] a[4] a[5] a[6] a[7] b[0] b[1] b[2] b[3] b[4] b[5] b[6] b[7] s
.outputs y[0] y[1] y[2] y[3] y[4] y[5] y[6] y[7]
.subckt $_MUX_ A=a[0] B=b[0] S=s Y=y[0]
.subckt $_MUX_ A=a[1] B=b[1] S=s Y=y[1]
.subckt $_MUX_ A=a[2] B=b[2] S=s Y=y[2]
.subckt $_MUX_ A=a[3] B=b[3] S=s Y=y[3]
.subckt $_MUX_ A=a[4] B=b[4] S=s Y=y[4]
.subckt $_MUX_ A=a[5] B=b[5] S=s Y=y[5]
.subckt $_MUX_ A=a[6] B=b[6] S=s Y=y[6]
.subckt $_MUX_ A=a[7] B=b[7] S=s Y=y[7]
.end
