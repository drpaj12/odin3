.model m
.inputs clk en rst d[0] d[1] d[2] d[3] d[4] d[5] d[6] d[7]
.outputs q[0] q[1] q[2] q[3] q[4] q[5] q[6] q[7]
.names gnd
.names vcc
1
.subckt $_MUX_ A=q[0] B=d[0] S=en Y=$n47
.cname q.mux0
.subckt $_MUX_ A=$n47 B=vcc S=rst Y=$n49
.cname q.mux1
.latch $n49 q[0] re clk 3
.cname q.dff_p2
.subckt $_MUX_ A=q[1] B=d[1] S=en Y=$n51
.cname q.mux3
.subckt $_MUX_ A=$n51 B=gnd S=rst Y=$n53
.cname q.mux4
.latch $n53 q[1] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=q[2] B=d[2] S=en Y=$n55
.cname q.mux6
.subckt $_MUX_ A=$n55 B=vcc S=rst Y=$n56
.cname q.mux7
.latch $n56 q[2] re clk 3
.cname q.dff_p8
.subckt $_MUX_ A=q[3] B=d[3] S=en Y=$n58
.cname q.mux9
.subckt $_MUX_ A=$n58 B=gnd S=rst Y=$n59
.cname q.mux10
.latch $n59 q[3] re clk 3
.cname q.dff_p11
.subckt $_MUX_ A=q[4] B=d[4] S=en Y=$n61
.cname q.mux12
.subckt $_MUX_ A=$n61 B=gnd S=rst Y=$n62
.cname q.mux13
.latch $n62 q[4] re clk 3
.cname q.dff_p14
.subckt $_MUX_ A=q[5] B=d[5] S=en Y=$n64
.cname q.mux15
.subckt $_MUX_ A=$n64 B=vcc S=rst Y=$n65
.cname q.mux16
.latch $n65 q[5] re clk 3
.cname q.dff_p17
.subckt $_MUX_ A=q[6] B=d[6] S=en Y=$n67
.cname q.mux18
.subckt $_MUX_ A=$n67 B=gnd S=rst Y=$n68
.cname q.mux19
.latch $n68 q[6] re clk 3
.cname q.dff_p20
.subckt $_MUX_ A=q[7] B=d[7] S=en Y=$n70
.cname q.mux21
.subckt $_MUX_ A=$n70 B=vcc S=rst Y=$n71
.cname q.mux22
.latch $n71 q[7] re clk 3
.cname q.dff_p23
.end
