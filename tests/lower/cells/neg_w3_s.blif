.model m
.inputs a[0] a[1] a[2]
.outputs y[0] y[1] y[2]
.names gnd
.names vcc
1
.subckt $_NOT_ A=a[0] Y=$n9
.subckt $_NOT_ A=a[1] Y=$n10
.subckt $_NOT_ A=a[2] Y=$n11
.subckt $_XOR_ A=gnd B=$n9 Y=$n12
.subckt $_AND_ A=gnd B=$n9 Y=$n13
.subckt $_XOR_ A=gnd B=$n10 Y=$n14
.subckt $_AND_ A=gnd B=$n10 Y=$n15
.subckt $_XOR_ A=gnd B=$n11 Y=$n16
.subckt $_AND_ A=gnd B=$n11 Y=$n17
.subckt $_AND_ A=$n12 B=vcc Y=$n18
.subckt $_OR_ A=$n13 B=$n18 Y=$n19
.subckt $_AND_ A=$n14 B=$n19 Y=$n20
.subckt $_OR_ A=$n15 B=$n20 Y=$n21
.subckt $_AND_ A=$n14 B=$n12 Y=$n22
.subckt $_AND_ A=$n16 B=$n21 Y=$n23
.subckt $_OR_ A=$n17 B=$n23 Y=$n24
.subckt $_AND_ A=$n16 B=$n22 Y=$n25
.subckt $_XOR_ A=$n12 B=vcc Y=y[0]
.subckt $_XOR_ A=$n14 B=$n19 Y=y[1]
.subckt $_XOR_ A=$n16 B=$n21 Y=y[2]
.end
