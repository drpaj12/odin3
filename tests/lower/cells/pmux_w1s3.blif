.model m
.inputs a b0 b1 b2 s[0] s[1] s[2]
.outputs y
.subckt $_OR_ A=s[2] B=s[1] Y=$n16
.subckt $_OR_ A=$n16 B=s[0] Y=$n17
.subckt $_AND_ A=b2 B=s[2] Y=$n18
.subckt $_AND_ A=b1 B=s[1] Y=$n19
.subckt $_AND_ A=b0 B=s[0] Y=$n20
.subckt $_OR_ A=$n18 B=$n19 Y=$n21
.subckt $_OR_ A=$n21 B=$n20 Y=$n22
.subckt $_MUX_ A=a B=$n22 S=$n17 Y=y
.end
