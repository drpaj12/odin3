.model m
.inputs clk ld ad[0] ad[1] ad[2] ad[3] d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_MUX_ A=ad[0] B=d[0] S=ld Y=$n28
.cname q.mux0
.latch $n28 q[0] re clk 3
.cname q.dff_p1
.subckt $_MUX_ A=ad[1] B=d[1] S=ld Y=$n30
.cname q.mux2
.latch $n30 q[1] re clk 3
.cname q.dff_p3
.subckt $_MUX_ A=ad[2] B=d[2] S=ld Y=$n32
.cname q.mux4
.latch $n32 q[2] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=ad[3] B=d[3] S=ld Y=$n34
.cname q.mux6
.latch $n34 q[3] re clk 3
.cname q.dff_p7
.end
