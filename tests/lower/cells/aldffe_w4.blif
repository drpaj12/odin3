.model m
.inputs clk en ld ad[0] ad[1] ad[2] ad[3] d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_MUX_ A=q[0] B=d[0] S=en Y=$n27
.cname q.mux0
.subckt $_MUX_ A=$n27 B=ad[0] S=ld Y=$n28
.cname q.mux1
.latch $n28 q[0] re clk 3
.cname q.dff_p2
.subckt $_MUX_ A=q[1] B=d[1] S=en Y=$n30
.cname q.mux3
.subckt $_MUX_ A=$n30 B=ad[1] S=ld Y=$n31
.cname q.mux4
.latch $n31 q[1] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=q[2] B=d[2] S=en Y=$n33
.cname q.mux6
.subckt $_MUX_ A=$n33 B=ad[2] S=ld Y=$n34
.cname q.mux7
.latch $n34 q[2] re clk 3
.cname q.dff_p8
.subckt $_MUX_ A=q[3] B=d[3] S=en Y=$n36
.cname q.mux9
.subckt $_MUX_ A=$n36 B=ad[3] S=ld Y=$n37
.cname q.mux10
.latch $n37 q[3] re clk 3
.cname q.dff_p11
.end
