.model m
.inputs clk en rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_MUX_ A=vcc B=d[0] S=rst Y=$n38
.cname q.mux0
.subckt $_MUX_ A=$n38 B=q[0] S=en Y=$n39
.cname q.mux1
.latch $n39 q[0] re clk 3
.cname q.dff_p2
.subckt $_MUX_ A=gnd B=d[1] S=rst Y=$n42
.cname q.mux3
.subckt $_MUX_ A=$n42 B=q[1] S=en Y=$n43
.cname q.mux4
.latch $n43 q[1] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=vcc B=d[2] S=rst Y=$n45
.cname q.mux6
.subckt $_MUX_ A=$n45 B=q[2] S=en Y=$n46
.cname q.mux7
.latch $n46 q[2] re clk 3
.cname q.dff_p8
.subckt $_MUX_ A=gnd B=d[3] S=rst Y=$n48
.cname q.mux9
.subckt $_MUX_ A=$n48 B=q[3] S=en Y=$n49
.cname q.mux10
.latch $n49 q[3] re clk 3
.cname q.dff_p11
.end
