.model m
.inputs clk en rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_NOT_ A=clk Y=$n34
.cname q.not0
.subckt $_MUX_ A=d[0] B=q[0] S=en Y=$n36
.cname q.mux1
.subckt $_MUX_ A=vcc B=$n36 S=rst Y=$n38
.cname q.mux2
.latch $n38 q[0] re $n34 3
.cname q.dff_p3
.subckt $_MUX_ A=d[1] B=q[1] S=en Y=$n40
.cname q.mux4
.subckt $_MUX_ A=gnd B=$n40 S=rst Y=$n42
.cname q.mux5
.latch $n42 q[1] re $n34 3
.cname q.dff_p6
.subckt $_MUX_ A=d[2] B=q[2] S=en Y=$n44
.cname q.mux7
.subckt $_MUX_ A=vcc B=$n44 S=rst Y=$n45
.cname q.mux8
.latch $n45 q[2] re $n34 3
.cname q.dff_p9
.subckt $_MUX_ A=d[3] B=q[3] S=en Y=$n47
.cname q.mux10
.subckt $_MUX_ A=gnd B=$n47 S=rst Y=$n48
.cname q.mux11
.latch $n48 q[3] re $n34 3
.cname q.dff_p12
.end
