.model m
.inputs clk en rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_NOT_ A=clk Y=$n36
.cname q.not0
.subckt $_MUX_ A=d[0] B=q[0] S=en Y=$n38
.cname q.mux1
.subckt $_MUX_ A=vcc B=$n38 S=rst Y=$n40
.cname q.mux2
.latch $n40 q[0] re $n36 3
.cname q.dff_p3
.subckt $_MUX_ A=d[1] B=q[1] S=en Y=$n42
.cname q.mux4
.subckt $_MUX_ A=gnd B=$n42 S=rst Y=$n44
.cname q.mux5
.latch $n44 q[1] re $n36 3
.cname q.dff_p6
.subckt $_MUX_ A=d[2] B=q[2] S=en Y=$n46
.cname q.mux7
.subckt $_MUX_ A=vcc B=$n46 S=rst Y=$n47
.cname q.mux8
.latch $n47 q[2] re $n36 3
.cname q.dff_p9
.subckt $_MUX_ A=d[3] B=q[3] S=en Y=$n49
.cname q.mux10
.subckt $_MUX_ A=gnd B=$n49 S=rst Y=$n50
.cname q.mux11
.latch $n50 q[3] re $n36 3
.cname q.dff_p12
.end
