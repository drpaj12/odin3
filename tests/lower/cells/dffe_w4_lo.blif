.model m
.inputs clk en d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_MUX_ A=d[0] B=q[0] S=en Y=$n26
.cname q.mux0
.latch $n26 q[0] re clk 3
.cname q.dff_p1
.subckt $_MUX_ A=d[1] B=q[1] S=en Y=$n28
.cname q.mux2
.latch $n28 q[1] re clk 3
.cname q.dff_p3
.subckt $_MUX_ A=d[2] B=q[2] S=en Y=$n30
.cname q.mux4
.latch $n30 q[2] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=d[3] B=q[3] S=en Y=$n32
.cname q.mux6
.latch $n32 q[3] re clk 3
.cname q.dff_p7
.end
