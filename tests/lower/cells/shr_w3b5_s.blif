.model m
.inputs a[0] a[1] a[2] b[0] b[1] b[2] b[3] b[4]
.outputs y[0] y[1] y[2]
.names gnd
.subckt $_OR_ A=b[3] B=b[4] Y=$n13
.subckt $_MUX_ A=a[0] B=gnd S=$n13 Y=$n14
.subckt $_MUX_ A=a[1] B=gnd S=$n13 Y=$n15
.subckt $_MUX_ A=a[2] B=gnd S=$n13 Y=$n16
.subckt $_MUX_ A=$n14 B=$n15 S=b[0] Y=$n17
.subckt $_MUX_ A=$n15 B=$n16 S=b[0] Y=$n18
.subckt $_MUX_ A=$n16 B=gnd S=b[0] Y=$n19
.subckt $_MUX_ A=$n17 B=$n19 S=b[1] Y=$n20
.subckt $_MUX_ A=$n18 B=gnd S=b[1] Y=$n21
.subckt $_MUX_ A=$n19 B=gnd S=b[1] Y=$n22
.subckt $_MUX_ A=$n20 B=gnd S=b[2] Y=y[0]
.subckt $_MUX_ A=$n21 B=gnd S=b[2] Y=y[1]
.subckt $_MUX_ A=$n22 B=gnd S=b[2] Y=y[2]
.end
