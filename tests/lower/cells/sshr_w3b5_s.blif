.model m
.inputs a[0] a[1] a[2] b[0] b[1] b[2] b[3] b[4]
.outputs y[0] y[1] y[2]
.subckt $_OR_ A=b[3] B=b[4] Y=$n12
.subckt $_MUX_ A=a[0] B=a[2] S=$n12 Y=$n13
.subckt $_MUX_ A=a[1] B=a[2] S=$n12 Y=$n14
.subckt $_MUX_ A=a[2] B=a[2] S=$n12 Y=$n15
.subckt $_MUX_ A=$n13 B=$n14 S=b[0] Y=$n17
.subckt $_MUX_ A=$n14 B=$n15 S=b[0] Y=$n18
.subckt $_MUX_ A=$n15 B=$n15 S=b[0] Y=$n19
.subckt $_MUX_ A=$n17 B=$n19 S=b[1] Y=$n20
.subckt $_MUX_ A=$n18 B=$n19 S=b[1] Y=$n21
.subckt $_MUX_ A=$n19 B=$n19 S=b[1] Y=$n22
.subckt $_MUX_ A=$n20 B=$n22 S=b[2] Y=y[0]
.subckt $_MUX_ A=$n21 B=$n22 S=b[2] Y=y[1]
.subckt $_MUX_ A=$n22 B=$n22 S=b[2] Y=y[2]
.end
