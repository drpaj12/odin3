.model m
.inputs a[0] a[1] a[2] a[3] a[4] b[0] b[1] b[2]
.outputs y
.names gnd
.subckt $_XOR_ A=a[0] B=b[0] Y=$n11
.subckt $_XOR_ A=a[1] B=b[1] Y=$n12
.subckt $_XOR_ A=a[2] B=b[2] Y=$n13
.subckt $_XOR_ A=a[3] B=gnd Y=$n14
.subckt $_XOR_ A=a[4] B=gnd Y=$n15
.subckt $_OR_ A=$n11 B=$n12 Y=$n16
.subckt $_OR_ A=$n13 B=$n14 Y=$n17
.subckt $_OR_ A=$n16 B=$n17 Y=$n18
.subckt $_OR_ A=$n18 B=$n15 Y=$n19
.subckt $_NOT_ A=$n19 Y=y
.end
