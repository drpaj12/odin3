.model m
.inputs clk en d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_NOT_ A=clk Y=$n25
.cname q.not0
.subckt $_MUX_ A=d[0] B=q[0] S=en Y=$n27
.cname q.mux1
.latch $n27 q[0] re $n25 3
.cname q.dff_p2
.subckt $_MUX_ A=d[1] B=q[1] S=en Y=$n29
.cname q.mux3
.latch $n29 q[1] re $n25 3
.cname q.dff_p4
.subckt $_MUX_ A=d[2] B=q[2] S=en Y=$n31
.cname q.mux5
.latch $n31 q[2] re $n25 3
.cname q.dff_p6
.subckt $_MUX_ A=d[3] B=q[3] S=en Y=$n33
.cname q.mux7
.latch $n33 q[3] re $n25 3
.cname q.dff_p8
.end
