.model m
.inputs clk en rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_NOT_ A=clk Y=$n36
.cname q.not0
.subckt $_MUX_ A=vcc B=d[0] S=rst Y=$n39
.cname q.mux1
.subckt $_MUX_ A=$n39 B=q[0] S=en Y=$n40
.cname q.mux2
.latch $n40 q[0] re $n36 3
.cname q.dff_p3
.subckt $_MUX_ A=gnd B=d[1] S=rst Y=$n43
.cname q.mux4
.subckt $_MUX_ A=$n43 B=q[1] S=en Y=$n44
.cname q.mux5
.latch $n44 q[1] re $n36 3
.cname q.dff_p6
.subckt $_MUX_ A=vcc B=d[2] S=rst Y=$n46
.cname q.mux7
.subckt $_MUX_ A=$n46 B=q[2] S=en Y=$n47
.cname q.mux8
.latch $n47 q[2] re $n36 3
.cname q.dff_p9
.subckt $_MUX_ A=gnd B=d[3] S=rst Y=$n49
.cname q.mux10
.subckt $_MUX_ A=$n49 B=q[3] S=en Y=$n50
.cname q.mux11
.latch $n50 q[3] re $n36 3
.cname q.dff_p12
.end
