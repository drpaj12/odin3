.model m
.inputs clk en rst d[0] d[1] d[2] d[3] d[4] d[5] d[6] d[7]
.outputs q[0] q[1] q[2] q[3] q[4] q[5] q[6] q[7]
.names gnd
.names vcc
1
.subckt $_MUX_ A=q[0] B=d[0] S=en Y=$n40
.cname q.mux0
.subckt $_MUX_ A=$n40 B=vcc S=rst Y=$n42
.cname q.mux1
.latch $n42 q[0] re clk 3
.cname q.dff_p2
.subckt $_MUX_ A=q[1] B=d[1] S=en Y=$n44
.cname q.mux3
.subckt $_MUX_ A=$n44 B=gnd S=rst Y=$n46
.cname q.mux4
.latch $n46 q[1] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=q[2] B=d[2] S=en Y=$n48
.cname q.mux6
.subckt $_MUX_ A=$n48 B=vcc S=rst Y=$n49
.cname q.mux7
.latch $n49 q[2] re clk 3
.cname q.dff_p8
.subckt $_MUX_ A=q[3] B=d[3] S=en Y=$n51
.cname q.mux9
.subckt $_MUX_ A=$n51 B=gnd S=rst Y=$n52
.cname q.mux10
.latch $n52 q[3] re clk 3
.cname q.dff_p11
.subckt $_MUX_ A=q[4] B=d[4] S=en Y=$n54
.cname q.mux12
.subckt $_MUX_ A=$n54 B=gnd S=rst Y=$n55
.cname q.mux13
.latch $n55 q[4] re clk 3
.cname q.dff_p14
.subckt $_MUX_ A=q[5] B=d[5] S=en Y=$n57
.cname q.mux15
.subckt $_MUX_ A=$n57 B=vcc S=rst Y=$n58
.cname q.mux16
.latch $n58 q[5] re clk 3
.cname q.dff_p17
.subckt $_MUX_ A=q[6] B=d[6] S=en Y=$n60
.cname q.mux18
.subckt $_MUX_ A=$n60 B=gnd S=rst Y=$n61
.cname q.mux19
.latch $n61 q[6] re clk 3
.cname q.dff_p20
.subckt $_MUX_ A=q[7] B=d[7] S=en Y=$n63
.cname q.mux21
.subckt $_MUX_ A=$n63 B=vcc S=rst Y=$n64
.cname q.mux22
.latch $n64 q[7] re clk 3
.cname q.dff_p23
.end
