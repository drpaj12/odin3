.model m
.inputs a[0] a[1] a[2] b[0] b[1] b[2]
.outputs y[0] y[1] y[2]
.names vcc
1
.subckt $_NOT_ A=b[0] Y=$n11
.subckt $_NOT_ A=b[1] Y=$n12
.subckt $_NOT_ A=b[2] Y=$n13
.subckt $_XOR_ A=a[0] B=$n11 Y=$n14
.subckt $_AND_ A=a[0] B=$n11 Y=$n15
.subckt $_XOR_ A=a[1] B=$n12 Y=$n16
.subckt $_AND_ A=a[1] B=$n12 Y=$n17
.subckt $_XOR_ A=a[2] B=$n13 Y=$n18
.subckt $_AND_ A=a[2] B=$n13 Y=$n19
.subckt $_AND_ A=$n14 B=vcc Y=$n20
.subckt $_OR_ A=$n15 B=$n20 Y=$n21
.subckt $_AND_ A=$n16 B=$n21 Y=$n22
.subckt $_OR_ A=$n17 B=$n22 Y=$n23
.subckt $_AND_ A=$n16 B=$n14 Y=$n24
.subckt $_AND_ A=$n18 B=$n23 Y=$n25
.subckt $_OR_ A=$n19 B=$n25 Y=$n26
.subckt $_AND_ A=$n18 B=$n24 Y=$n27
.subckt $_XOR_ A=$n14 B=vcc Y=y[0]
.subckt $_XOR_ A=$n16 B=$n21 Y=y[1]
.subckt $_XOR_ A=$n18 B=$n23 Y=y[2]
.end
