.model m
.inputs clk en ld ad[0] ad[1] ad[2] ad[3] d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_MUX_ A=d[0] B=q[0] S=en Y=$n38
.cname q.mux0
.subckt $_MUX_ A=ad[0] B=$n38 S=ld Y=$n39
.cname q.mux1
.latch $n39 q[0] re clk 3
.cname q.dff_p2
.subckt $_MUX_ A=d[1] B=q[1] S=en Y=$n41
.cname q.mux3
.subckt $_MUX_ A=ad[1] B=$n41 S=ld Y=$n42
.cname q.mux4
.latch $n42 q[1] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=d[2] B=q[2] S=en Y=$n44
.cname q.mux6
.subckt $_MUX_ A=ad[2] B=$n44 S=ld Y=$n45
.cname q.mux7
.latch $n45 q[2] re clk 3
.cname q.dff_p8
.subckt $_MUX_ A=d[3] B=q[3] S=en Y=$n47
.cname q.mux9
.subckt $_MUX_ A=ad[3] B=$n47 S=ld Y=$n48
.cname q.mux10
.latch $n48 q[3] re clk 3
.cname q.dff_p11
.end
