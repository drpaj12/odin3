.model m
.inputs clk rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_NOT_ A=clk Y=$n18
.cname q.not0
.subckt $_MUX_ A=d[0] B=vcc S=rst Y=$n21
.cname q.mux1
.latch $n21 q[0] re $n18 3
.cname q.dff_p2
.subckt $_MUX_ A=d[1] B=gnd S=rst Y=$n24
.cname q.mux3
.latch $n24 q[1] re $n18 3
.cname q.dff_p4
.subckt $_MUX_ A=d[2] B=vcc S=rst Y=$n26
.cname q.mux5
.latch $n26 q[2] re $n18 3
.cname q.dff_p6
.subckt $_MUX_ A=d[3] B=gnd S=rst Y=$n28
.cname q.mux7
.latch $n28 q[3] re $n18 3
.cname q.dff_p8
.end
