.model m
.inputs clk en rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_MUX_ A=d[0] B=q[0] S=en Y=$n35
.cname q.mux0
.subckt $_MUX_ A=vcc B=$n35 S=rst Y=$n37
.cname q.mux1
.latch $n37 q[0] re clk 3
.cname q.dff_p2
.subckt $_MUX_ A=d[1] B=q[1] S=en Y=$n39
.cname q.mux3
.subckt $_MUX_ A=gnd B=$n39 S=rst Y=$n41
.cname q.mux4
.latch $n41 q[1] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=d[2] B=q[2] S=en Y=$n43
.cname q.mux6
.subckt $_MUX_ A=vcc B=$n43 S=rst Y=$n44
.cname q.mux7
.latch $n44 q[2] re clk 3
.cname q.dff_p8
.subckt $_MUX_ A=d[3] B=q[3] S=en Y=$n46
.cname q.mux9
.subckt $_MUX_ A=gnd B=$n46 S=rst Y=$n47
.cname q.mux10
.latch $n47 q[3] re clk 3
.cname q.dff_p11
.end
