.model m
.inputs a b
.outputs y
.names vcc
1
.subckt $_NOT_ A=b Y=$n5
.subckt $_XOR_ A=a B=$n5 Y=$n6
.subckt $_AND_ A=a B=$n5 Y=$n7
.subckt $_AND_ A=$n6 B=vcc Y=$n8
.subckt $_OR_ A=$n7 B=$n8 Y=$n9
.subckt $_XOR_ A=$n9 B=vcc Y=$n10
.subckt $_XOR_ A=$n6 B=vcc Y=$n11
.subckt $_XOR_ A=$n10 B=$n11 Y=$n12
.subckt $_OR_ A=$n12 B=$n6 Y=$n13
.subckt $_NOT_ A=$n13 Y=$n14
.subckt $_OR_ A=$n14 B=$n6 Y=y
.end
