.model m
.inputs clk rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_MUX_ A=d[0] B=vcc S=rst Y=$n20
.cname q.mux0
.latch $n20 q[0] re clk 3
.cname q.dff_p1
.subckt $_MUX_ A=d[1] B=gnd S=rst Y=$n23
.cname q.mux2
.latch $n23 q[1] re clk 3
.cname q.dff_p3
.subckt $_MUX_ A=d[2] B=vcc S=rst Y=$n25
.cname q.mux4
.latch $n25 q[2] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=d[3] B=gnd S=rst Y=$n27
.cname q.mux6
.latch $n27 q[3] re clk 3
.cname q.dff_p7
.end
