.model m
.inputs a[0] a[1] a[2] a[3] b[0] b[1] b[2]
.outputs y[0] y[1]
.names unconn
.subckt $_MUX_ A=a[0] B=a[1] S=b[0] Y=$n11
.subckt $_MUX_ A=a[1] B=a[2] S=b[0] Y=$n12
.subckt $_MUX_ A=a[2] B=a[3] S=b[0] Y=$n13
.subckt $_MUX_ A=a[3] B=unconn S=b[0] Y=$n14
.subckt $_MUX_ A=$n11 B=$n13 S=b[1] Y=$n15
.subckt $_MUX_ A=$n12 B=$n14 S=b[1] Y=$n16
.subckt $_MUX_ A=$n13 B=unconn S=b[1] Y=$n17
.subckt $_MUX_ A=$n14 B=unconn S=b[1] Y=$n18
.subckt $_MUX_ A=$n15 B=unconn S=b[2] Y=y[0]
.subckt $_MUX_ A=$n16 B=unconn S=b[2] Y=y[1]
.subckt $_MUX_ A=$n17 B=unconn S=b[2] Y=$n21
.subckt $_MUX_ A=$n18 B=unconn S=b[2] Y=$n22
.end
