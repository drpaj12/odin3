.model m
.inputs clk en rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_NOT_ A=clk Y=$n26
.cname q.not0
.subckt $_MUX_ A=d[0] B=vcc S=rst Y=$n29
.cname q.mux1
.subckt $_MUX_ A=q[0] B=$n29 S=en Y=$n30
.cname q.mux2
.latch $n30 q[0] re $n26 3
.cname q.dff_p3
.subckt $_MUX_ A=d[1] B=gnd S=rst Y=$n33
.cname q.mux4
.subckt $_MUX_ A=q[1] B=$n33 S=en Y=$n34
.cname q.mux5
.latch $n34 q[1] re $n26 3
.cname q.dff_p6
.subckt $_MUX_ A=d[2] B=vcc S=rst Y=$n36
.cname q.mux7
.subckt $_MUX_ A=q[2] B=$n36 S=en Y=$n37
.cname q.mux8
.latch $n37 q[2] re $n26 3
.cname q.dff_p9
.subckt $_MUX_ A=d[3] B=gnd S=rst Y=$n39
.cname q.mux10
.subckt $_MUX_ A=q[3] B=$n39 S=en Y=$n40
.cname q.mux11
.latch $n40 q[3] re $n26 3
.cname q.dff_p12
.end
