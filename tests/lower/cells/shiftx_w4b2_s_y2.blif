.model m
.inputs a[0] a[1] a[2] a[3] b[0] b[1]
.outputs y[0] y[1]
.names unconn
.subckt $_MUX_ A=a[0] B=unconn S=b[1] Y=$n10
.subckt $_MUX_ A=a[1] B=unconn S=b[1] Y=$n11
.subckt $_MUX_ A=a[2] B=a[0] S=b[1] Y=$n12
.subckt $_MUX_ A=a[3] B=a[1] S=b[1] Y=$n13
.subckt $_MUX_ A=unconn B=a[2] S=b[1] Y=$n14
.subckt $_MUX_ A=unconn B=a[3] S=b[1] Y=$n15
.subckt $_MUX_ A=$n10 B=$n11 S=b[0] Y=y[0]
.subckt $_MUX_ A=$n11 B=$n12 S=b[0] Y=y[1]
.subckt $_MUX_ A=$n12 B=$n13 S=b[0] Y=$n18
.subckt $_MUX_ A=$n13 B=$n14 S=b[0] Y=$n19
.subckt $_MUX_ A=$n14 B=$n15 S=b[0] Y=$n20
.subckt $_MUX_ A=$n15 B=unconn S=b[0] Y=$n21
.end
