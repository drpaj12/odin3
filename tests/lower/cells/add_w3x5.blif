.model m
.inputs a[0] a[1] a[2] b[0] b[1] b[2] b[3] b[4]
.outputs y[0] y[1] y[2] y[3] y[4]
.names gnd
.subckt $_XOR_ A=a[0] B=b[0] Y=$n15
.subckt $_AND_ A=a[0] B=b[0] Y=$n16
.subckt $_XOR_ A=a[1] B=b[1] Y=$n17
.subckt $_AND_ A=a[1] B=b[1] Y=$n18
.subckt $_XOR_ A=a[2] B=b[2] Y=$n19
.subckt $_AND_ A=a[2] B=b[2] Y=$n20
.subckt $_XOR_ A=gnd B=b[3] Y=$n21
.subckt $_AND_ A=gnd B=b[3] Y=$n22
.subckt $_XOR_ A=gnd B=b[4] Y=$n23
.subckt $_AND_ A=gnd B=b[4] Y=$n24
.subckt $_AND_ A=$n15 B=gnd Y=$n25
.subckt $_OR_ A=$n16 B=$n25 Y=$n26
.subckt $_AND_ A=$n17 B=$n26 Y=$n27
.subckt $_OR_ A=$n18 B=$n27 Y=$n28
.subckt $_AND_ A=$n17 B=$n15 Y=$n29
.subckt $_AND_ A=$n21 B=$n20 Y=$n30
.subckt $_OR_ A=$n22 B=$n30 Y=$n31
.subckt $_AND_ A=$n21 B=$n19 Y=$n32
.subckt $_AND_ A=$n32 B=$n28 Y=$n33
.subckt $_OR_ A=$n31 B=$n33 Y=$n34
.subckt $_AND_ A=$n32 B=$n29 Y=$n35
.subckt $_AND_ A=$n19 B=$n28 Y=$n36
.subckt $_OR_ A=$n20 B=$n36 Y=$n37
.subckt $_AND_ A=$n19 B=$n29 Y=$n38
.subckt $_AND_ A=$n23 B=$n34 Y=$n39
.subckt $_OR_ A=$n24 B=$n39 Y=$n40
.subckt $_AND_ A=$n23 B=$n35 Y=$n41
.subckt $_XOR_ A=$n15 B=gnd Y=y[0]
.subckt $_XOR_ A=$n17 B=$n26 Y=y[1]
.subckt $_XOR_ A=$n19 B=$n28 Y=y[2]
.subckt $_XOR_ A=$n21 B=$n37 Y=y[3]
.subckt $_XOR_ A=$n23 B=$n34 Y=y[4]
.end
