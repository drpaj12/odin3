.model m
.inputs clk en rst d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.names gnd
.names vcc
1
.subckt $_NOT_ A=clk Y=$n26
.cname q.not0
.subckt $_MUX_ A=q[0] B=d[0] S=en Y=$n28
.cname q.mux1
.subckt $_MUX_ A=$n28 B=vcc S=rst Y=$n30
.cname q.mux2
.latch $n30 q[0] re $n26 3
.cname q.dff_p3
.subckt $_MUX_ A=q[1] B=d[1] S=en Y=$n32
.cname q.mux4
.subckt $_MUX_ A=$n32 B=gnd S=rst Y=$n34
.cname q.mux5
.latch $n34 q[1] re $n26 3
.cname q.dff_p6
.subckt $_MUX_ A=q[2] B=d[2] S=en Y=$n36
.cname q.mux7
.subckt $_MUX_ A=$n36 B=vcc S=rst Y=$n37
.cname q.mux8
.latch $n37 q[2] re $n26 3
.cname q.dff_p9
.subckt $_MUX_ A=q[3] B=d[3] S=en Y=$n39
.cname q.mux10
.subckt $_MUX_ A=$n39 B=gnd S=rst Y=$n40
.cname q.mux11
.latch $n40 q[3] re $n26 3
.cname q.dff_p12
.end
