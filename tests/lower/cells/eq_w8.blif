.model m
.inputs a[0] a[1] a[2] a[3] a[4] a[5] a[6] a[7] b[0] b[1] b[2] b[3] b[4] b[5] b[6] b[7]
.outputs y
.subckt $_XOR_ A=a[0] B=b[0] Y=$n18
.subckt $_XOR_ A=a[1] B=b[1] Y=$n19
.subckt $_XOR_ A=a[2] B=b[2] Y=$n20
.subckt $_XOR_ A=a[3] B=b[3] Y=$n21
.subckt $_XOR_ A=a[4] B=b[4] Y=$n22
.subckt $_XOR_ A=a[5] B=b[5] Y=$n23
.subckt $_XOR_ A=a[6] B=b[6] Y=$n24
.subckt $_XOR_ A=a[7] B=b[7] Y=$n25
.subckt $_OR_ A=$n18 B=$n19 Y=$n26
.subckt $_OR_ A=$n20 B=$n21 Y=$n27
.subckt $_OR_ A=$n22 B=$n23 Y=$n28
.subckt $_OR_ A=$n24 B=$n25 Y=$n29
.subckt $_OR_ A=$n26 B=$n27 Y=$n30
.subckt $_OR_ A=$n28 B=$n29 Y=$n31
.subckt $_OR_ A=$n30 B=$n31 Y=$n32
.subckt $_NOT_ A=$n32 Y=y
.end
