.model m
.inputs a[0] a[1] a[2] a[3] a[4] a[5] a[6] a[7]
.outputs y
.subckt $_AND_ A=a[0] B=a[1] Y=$n10
.subckt $_AND_ A=a[2] B=a[3] Y=$n11
.subckt $_AND_ A=a[4] B=a[5] Y=$n12
.subckt $_AND_ A=a[6] B=a[7] Y=$n13
.subckt $_AND_ A=$n10 B=$n11 Y=$n14
.subckt $_AND_ A=$n12 B=$n13 Y=$n15
.subckt $_AND_ A=$n14 B=$n15 Y=y
.end
