.model m
.inputs clk en d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_MUX_ A=q[0] B=d[0] S=en Y=$n21
.cname q.mux0
.latch $n21 q[0] re clk 3
.cname q.dff_p1
.subckt $_MUX_ A=q[1] B=d[1] S=en Y=$n23
.cname q.mux2
.latch $n23 q[1] re clk 3
.cname q.dff_p3
.subckt $_MUX_ A=q[2] B=d[2] S=en Y=$n25
.cname q.mux4
.latch $n25 q[2] re clk 3
.cname q.dff_p5
.subckt $_MUX_ A=q[3] B=d[3] S=en Y=$n27
.cname q.mux6
.latch $n27 q[3] re clk 3
.cname q.dff_p7
.end
