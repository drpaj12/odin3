.model m
.inputs clk ld ad[0] ad[1] ad[2] ad[3] d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_NOT_ A=clk Y=$n27
.cname q.not0
.subckt $_MUX_ A=ad[0] B=d[0] S=ld Y=$n29
.cname q.mux1
.latch $n29 q[0] re $n27 3
.cname q.dff_p2
.subckt $_MUX_ A=ad[1] B=d[1] S=ld Y=$n31
.cname q.mux3
.latch $n31 q[1] re $n27 3
.cname q.dff_p4
.subckt $_MUX_ A=ad[2] B=d[2] S=ld Y=$n33
.cname q.mux5
.latch $n33 q[2] re $n27 3
.cname q.dff_p6
.subckt $_MUX_ A=ad[3] B=d[3] S=ld Y=$n35
.cname q.mux7
.latch $n35 q[3] re $n27 3
.cname q.dff_p8
.end
