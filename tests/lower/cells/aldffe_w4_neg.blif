.model m
.inputs clk en ld ad[0] ad[1] ad[2] ad[3] d[0] d[1] d[2] d[3]
.outputs q[0] q[1] q[2] q[3]
.subckt $_NOT_ A=clk Y=$n26
.cname q.not0
.subckt $_MUX_ A=q[0] B=d[0] S=en Y=$n28
.cname q.mux1
.subckt $_MUX_ A=$n28 B=ad[0] S=ld Y=$n29
.cname q.mux2
.latch $n29 q[0] re $n26 3
.cname q.dff_p3
.subckt $_MUX_ A=q[1] B=d[1] S=en Y=$n31
.cname q.mux4
.subckt $_MUX_ A=$n31 B=ad[1] S=ld Y=$n32
.cname q.mux5
.latch $n32 q[1] re $n26 3
.cname q.dff_p6
.subckt $_MUX_ A=q[2] B=d[2] S=en Y=$n34
.cname q.mux7
.subckt $_MUX_ A=$n34 B=ad[2] S=ld Y=$n35
.cname q.mux8
.latch $n35 q[2] re $n26 3
.cname q.dff_p9
.subckt $_MUX_ A=q[3] B=d[3] S=en Y=$n37
.cname q.mux10
.subckt $_MUX_ A=$n37 B=ad[3] S=ld Y=$n38
.cname q.mux11
.latch $n38 q[3] re $n26 3
.cname q.dff_p12
.end
