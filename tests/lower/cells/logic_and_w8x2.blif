.model m
.inputs a[0] a[1] a[2] a[3] a[4] a[5] a[6] a[7] b[0] b[1]
.outputs y
.subckt $_OR_ A=a[0] B=a[1] Y=$n12
.subckt $_OR_ A=a[2] B=a[3] Y=$n13
.subckt $_OR_ A=a[4] B=a[5] Y=$n14
.subckt $_OR_ A=a[6] B=a[7] Y=$n15
.subckt $_OR_ A=$n12 B=$n13 Y=$n16
.subckt $_OR_ A=$n14 B=$n15 Y=$n17
.subckt $_OR_ A=$n16 B=$n17 Y=$n18
.subckt $_OR_ A=b[0] B=b[1] Y=$n19
.subckt $_AND_ A=$n18 B=$n19 Y=y
.end
