.model m
.inputs a[0] a[1] b0[0] b0[1] b1[0] b1[1] b2[0] b2[1] s[0] s[1] s[2]
.outputs y[0] y[1]
.subckt $_OR_ A=s[2] B=s[1] Y=$n24
.subckt $_OR_ A=$n24 B=s[0] Y=$n25
.subckt $_AND_ A=b2[0] B=s[2] Y=$n26
.subckt $_AND_ A=b1[0] B=s[1] Y=$n27
.subckt $_AND_ A=b0[0] B=s[0] Y=$n28
.subckt $_OR_ A=$n26 B=$n27 Y=$n29
.subckt $_OR_ A=$n29 B=$n28 Y=$n30
.subckt $_MUX_ A=a[0] B=$n30 S=$n25 Y=y[0]
.subckt $_AND_ A=b2[1] B=s[2] Y=$n32
.subckt $_AND_ A=b1[1] B=s[1] Y=$n33
.subckt $_AND_ A=b0[1] B=s[0] Y=$n34
.subckt $_OR_ A=$n32 B=$n33 Y=$n35
.subckt $_OR_ A=$n35 B=$n34 Y=$n36
.subckt $_MUX_ A=a[1] B=$n36 S=$n25 Y=y[1]
.end
