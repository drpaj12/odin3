# The 5.2 gate level (the gold is BLIF: the RTLIL writer has no bit storage cells): the word script, then flatten and lower.
# --nolatches: write_blif --vtr refuses a level-sensitive latch, and the gold here is BLIF (the word and
# LPM levels allow latches, so $dlatch is read back there).
read_verilog --nolatches @DESIGN@
proc
opt
opt_clean
flatten
opt -full
lower
opt -fast
write_blif --vtr @IL@
write_verilog @OUT@
