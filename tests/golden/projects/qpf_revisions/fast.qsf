# Revision "fast": not the current revision, never read (it would give STAGES 3 and a define).
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name VERILOG_FILE src/mac.v
set_global_assignment -name VERILOG_FILE src/top.v
set_global_assignment -name VERILOG_MACRO "FAST"
set_parameter -name STAGES 3
