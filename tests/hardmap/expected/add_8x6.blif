# Odin III 0.0.0 write_blif --vtr (K=6, names short)

.model add_8x6
.inputs a[0] a[1] a[2] a[3] a[4] a[5] a[6] a[7] b[0] b[1] b[2] b[3] b[4] b[5]
.outputs y[0] y[1] y[2] y[3] y[4] y[5] y[6] y[7] y[8]
.names gnd
.names vcc
1
.subckt adder a=vcc b=gnd cin=gnd cout=$n26 sumout=$n27
.subckt adder a=a[0] b=b[0] cin=$n26 cout=$n28 sumout=$n15
.subckt adder a=a[1] b=b[1] cin=$n28 cout=$n30 sumout=$n16
.subckt adder a=a[2] b=b[2] cin=$n30 cout=$n32 sumout=$n17
.subckt adder a=a[3] b=b[3] cin=$n32 cout=$n34 sumout=$n18
.subckt adder a=a[4] b=b[4] cin=$n34 cout=$n36 sumout=$n19
.subckt adder a=a[5] b=b[5] cin=$n36 cout=$n38 sumout=$n20
.subckt adder a=a[6] b=gnd cin=$n38 cout=$n40 sumout=$n21
.subckt adder a=a[7] b=gnd cin=$n40 cout=$n42 sumout=$n22
.subckt adder a=gnd b=gnd cin=$n42 cout=$n44 sumout=$n23
.names $n15 y[0]
1 1
.names $n16 y[1]
1 1
.names $n17 y[2]
1 1
.names $n18 y[3]
1 1
.names $n19 y[4]
1 1
.names $n20 y[5]
1 1
.names $n21 y[6]
1 1
.names $n22 y[7]
1 1
.names $n23 y[8]
1 1
.end

.model adder
.inputs a b cin
.outputs cout sumout
.blackbox
.end
