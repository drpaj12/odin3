# yosys 0.55 (VTR build): read_rtlil order_b.il; opt_muxtree; write_rtlil   (hand-written input, read unedited by both)
# a random layered mux DAG (fan-out > 1 everywhere) from a scratch generator: Yosys evaluates the roots in descending cell order, so the promotion of a non-pure root to a pure one prunes later evaluations
# normalised by name: see the top of test_opt_muxtree.c
cell $mux WIDTH=1 A=1 B=d0:0 S=s1:0 Y=y4:0
cell $mux WIDTH=1 A=y11:0 B=y11:0 S=s0:0 Y=y10:0
cell $mux WIDTH=1 A=y13:0 B=y11:0 S=s1:0 Y=y16:0
cell $mux WIDTH=1 A=y4:0 B=y4:0 S=s2:0 Y=y11:0
cell $pmux WIDTH=1 S_WIDTH=2 A=y4:0 B=y4:0 d3:0 S=s0:0 s2:0 Y=y12:0
cell $pmux WIDTH=1 S_WIDTH=3 A=0 B=y11:0 y12:0 0 S=s2:0 s0:0 s1:0 Y=y13:0
wire y0:0 -> 0
wire y1:0 -> 1
wire y5:0 -> y4:0
wire y6:0 -> y4:0
wire y8:0 -> y4:0
wire y9:0 -> y11:0
removed 20
