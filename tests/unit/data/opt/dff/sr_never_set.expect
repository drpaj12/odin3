# yosys 0.55 (VTR build): read_rtlil sr_never_set.il; opt_dff; write_rtlil
# input: Yosys 0.55's own write_rtlil of the `read_verilog -icells` heredoc of tests/opt/opt_dff_sr.ys (never-active SET) in the Yosys source (sr_never_set.il), edited by sed in two places: `parameter \X_POLARITY 1'b` written `b` and `parameter signed \WIDTH` written `parameter \WIDTH` (proc_build.c reads plain integer polarity and width parameters; the 2D-1 read_rtlil gap), in every cell
# flags:
cell $adff ARST_POLARITY=1 ARST_VALUE=6'000000 CLK_POLARITY=1 WIDTH=6
cell $adffe ARST_POLARITY=0 ARST_VALUE=6'000000 CLK_POLARITY=1 EN_POLARITY=1 WIDTH=6
cell $adlatch ARST_POLARITY=1 ARST_VALUE=6'000000 EN_POLARITY=1 WIDTH=6
const Q 18 0
const Q 19 0
const Q 20 0
const Q 21 0
const Q 22 0
const Q 23 0
