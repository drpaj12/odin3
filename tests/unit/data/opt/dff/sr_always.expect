# yosys 0.55 (VTR build): read_rtlil sr_always.il; opt_dff; write_rtlil
# input: Yosys 0.55's own write_rtlil of the `read_verilog -icells` heredoc of tests/opt/opt_dff_sr.ys (always-active SET/CLR) in the Yosys source (sr_always.il), edited by sed in two places: `parameter \X_POLARITY 1'b` written `b` and `parameter signed \WIDTH` written `parameter \WIDTH` (proc_build.c reads plain integer polarity and width parameters; the 2D-1 read_rtlil gap), in every cell
# flags:
cell $dffsr CLK_POLARITY=1 CLR_POLARITY=1 SET_POLARITY=1 WIDTH=2
cell $dffsre CLK_POLARITY=1 CLR_POLARITY=0 EN_POLARITY=1 SET_POLARITY=0 WIDTH=2
cell $dlatchsr CLR_POLARITY=1 EN_POLARITY=1 SET_POLARITY=0 WIDTH=2
cell $not A_SIGNED=0 A_WIDTH=1 Y_WIDTH=1
cell $not A_SIGNED=0 A_WIDTH=1 Y_WIDTH=1
cell $not A_SIGNED=0 A_WIDTH=1 Y_WIDTH=1
cell $not A_SIGNED=0 A_WIDTH=1 Y_WIDTH=1
const Q 0 0
const Q 12 0
const Q 14 0
const Q 18 0
const Q 19 0
const Q 2 0
const Q 20 1
const Q 22 0
const Q 6 0
const Q 7 0
