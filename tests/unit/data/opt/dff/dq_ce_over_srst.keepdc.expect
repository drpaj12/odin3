# yosys 0.55 (VTR build): read_rtlil dq_ce_over_srst.il; opt_dff -keepdc; write_rtlil
# input: hand-written (dq_ce_over_srst.il), read unedited by Yosys and by proc_build
# flags: -keepdc
cell $and A_SIGNED=0 A_WIDTH=1 B_SIGNED=0 B_WIDTH=1 Y_WIDTH=1
cell $and A_SIGNED=0 A_WIDTH=1 B_SIGNED=0 B_WIDTH=1 Y_WIDTH=1
cell $dffe CLK_POLARITY=1 EN_POLARITY=0 WIDTH=1
cell $dffe CLK_POLARITY=1 EN_POLARITY=0 WIDTH=1
cell $dffe CLK_POLARITY=1 EN_POLARITY=1 WIDTH=1
cell $dffe CLK_POLARITY=1 EN_POLARITY=1 WIDTH=1
cell $not A_SIGNED=0 A_WIDTH=1 Y_WIDTH=1
cell $not A_SIGNED=0 A_WIDTH=1 Y_WIDTH=1
