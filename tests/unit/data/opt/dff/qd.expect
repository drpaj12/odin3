# yosys 0.55 (VTR build): read_rtlil qd.il; opt_dff; write_rtlil
# input: Yosys 0.55's own write_rtlil of the `read_verilog -icells` heredoc of tests/opt/opt_dff_qd.ys in the Yosys source (qd.il), edited by sed in two places: `parameter \X_POLARITY 1'b` written `b` and `parameter signed \WIDTH` written `parameter \WIDTH` (proc_build.c reads plain integer polarity and width parameters; the 2D-1 read_rtlil gap), in every cell
# flags:
cell $and A_SIGNED=0 A_WIDTH=1 B_SIGNED=0 B_WIDTH=1 Y_WIDTH=1
cell $dffe CLK_POLARITY=1 EN_POLARITY=1 WIDTH=2
cell $dffe CLK_POLARITY=1 EN_POLARITY=1 WIDTH=2
cell $dffe CLK_POLARITY=1 EN_POLARITY=1 WIDTH=2
cell $dlatch EN_POLARITY=1 WIDTH=2
cell $dlatch EN_POLARITY=1 WIDTH=2
cell $sr CLR_POLARITY=1 SET_POLARITY=0 WIDTH=2
cell $sr CLR_POLARITY=1 SET_POLARITY=0 WIDTH=2
const Q 0 1
const Q 1 0
const Q 2 1
const Q 3 0
init Q 01010101010101xxxx
