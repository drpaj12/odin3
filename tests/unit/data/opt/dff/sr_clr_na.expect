# yosys 0.55 (VTR build): read_rtlil sr_clr_na.il; opt_dff; write_rtlil
# input: Yosys 0.55's own write_rtlil of the `read_verilog -icells` heredoc of tests/opt/opt_dff_sr.ys (never-active CLR, not applicable) in the Yosys source (sr_clr_na.il), edited by sed in two places: `parameter \X_POLARITY 1'b` written `b` and `parameter signed \WIDTH` written `parameter \WIDTH` (proc_build.c reads plain integer polarity and width parameters; the 2D-1 read_rtlil gap), in every cell
# flags:
cell $dffsr CLK_POLARITY=1 CLR_POLARITY=1 SET_POLARITY=1 WIDTH=6
cell $dffsre CLK_POLARITY=1 CLR_POLARITY=0 EN_POLARITY=1 SET_POLARITY=0 WIDTH=6
cell $dlatchsr CLR_POLARITY=1 EN_POLARITY=1 SET_POLARITY=0 WIDTH=6
const Q 18 1
const Q 19 1
const Q 20 1
const Q 21 1
const Q 22 1
const Q 23 1
