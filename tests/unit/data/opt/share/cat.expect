# yosys 0.55 (VTR build): ulimit -v 3000000; yosys -q -p 'read_rtlil cat.il; opt_share; write_rtlil'
cell $add A_WIDTH=16 B_WIDTH=16 Y_WIDTH=16
cell $add A_WIDTH=16 B_WIDTH=16 Y_WIDTH=16
cell $mux WIDTH=16
cell $mux WIDTH=16
cell $mux WIDTH=32
cell $neg A_WIDTH=16 Y_WIDTH=16
cell $neg A_WIDTH=16 Y_WIDTH=16
# diverges (spec 17 #44): each half of the 32-bit port is a different cell; Odin III merges only a
# port driven by one cell, so nothing is merged
odin3 cell $add A_WIDTH=16 B_WIDTH=16 Y_WIDTH=16
odin3 cell $add A_WIDTH=16 B_WIDTH=16 Y_WIDTH=16
odin3 cell $mux WIDTH=32
odin3 cell $sub A_WIDTH=16 B_WIDTH=16 Y_WIDTH=16
odin3 cell $sub A_WIDTH=16 B_WIDTH=16 Y_WIDTH=16
