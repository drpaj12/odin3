.model top_module
.inputs a~0 a~1 b~1 b~0 cin
.outputs sumout~0 sumout~1 cout
.names gnd
.names vcc
1
.names unconn
.subckt adder a=vcc cin=gnd b=gnd sumout=$add~1^ADD~0-0~dummy_output~0~1 cout=$add~1^ADD~0-0[0]
.subckt adder a=$add~0^ADD~1-1[1] cin=$add~1^ADD~0-0[0] b=cin sumout=sumout~0 \
  cout=$add~1^ADD~0-1[0]
.subckt adder a=$add~0^ADD~1-2[1] cin=$add~1^ADD~0-1[0] b=unconn sumout=sumout~1 \
  cout=$add~1^ADD~0-2[0]
.subckt adder a=$add~0^ADD~1-3[1] cin=$add~1^ADD~0-2[0] b=unconn sumout=cout \
  cout=$add~1^ADD~0-3[0]
.subckt adder a=vcc cin=gnd b=gnd sumout=$add~0^ADD~1-0~dummy_output~0~1 cout=$add~0^ADD~1-0[0]
.subckt adder a=a~0 cin=$add~0^ADD~1-0[0] b=b~0 sumout=$add~0^ADD~1-1[1] cout=$add~0^ADD~1-1[0]
.subckt adder a=a~1 cin=$add~0^ADD~1-1[0] b=b~1 sumout=$add~0^ADD~1-2[1] cout=$add~0^ADD~1-2[0]
.subckt adder a=gnd cin=$add~0^ADD~1-2[0] b=gnd sumout=$add~0^ADD~1-3[1] \
  cout=$add~0^ADD~1-3~dummy_output~3~0
.end

.model adder
.inputs a cin b
.outputs sumout cout
.blackbox
.end
