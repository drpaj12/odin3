<?xml version="1.0" encoding="UTF-8"?>
<!-- every PRJ-15 rule (test_project_odin2.c) -->
<config>
    <verilog_files>
        <verilog_file>src/a.v</verilog_file>
        <verilog_file> src/../src/b.v </verilog_file>
        <verilog_file>src/a.v</verilog_file>
        <include_file>x.vh</include_file>
    </verilog_files>
    <inputs>
        <input_type> BLIF </input_type>
        <input_path_and_name>net/n.blif</input_path_and_name>
        <extra/>
    </inputs>
    <inputs>
        <input_path_and_name>src/c.v</input_path_and_name>
    </inputs>
    <output>
        <output_type>BLIF</output_type>
        <output_path_and_name>out/../out/top.blif</output_path_and_name>
        <target>
            <arch_file>arch/k6.xml</arch_file>
            <arch_file>arch/t.o3lib</arch_file>
            <device>x</device>
        </target>
        <log_file>l</log_file>
    </output>
    <output>
        <output_type>verilog</output_type>
    </output>
    <optimizations>
        <multiply size="9" fixed="1" fracture="0"/>
        <multiply fixed="1"/>
        <adder threshold_size='4' other="x"/>
        <memory split_memory_width="1" split_memory_depth="max" extra="1"/>
        <memory split_memory_depth="064"/>
        <memory split_memory_width="0"/>
        <memory/>
        <mix_soft_hard_blocks mults_ratio="0.5"/>
    </optimizations>
    <debug_outputs>
        <debug_output_path>.</debug_output_path>
    </debug_outputs>
</config>
