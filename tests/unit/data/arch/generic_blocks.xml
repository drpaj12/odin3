<?xml version="1.0"?>
<!-- 4.2 Tasks 7 and 8: three generic blocks (a multiplier-like block that is not the `multiply`
     template, a dual-port RAM of its own, a block with a clock) and a model whose name is not a
     Verilog identifier (not registered). -->
<architecture>
  <models>
    <model name="mult_8">
      <input_ports>
        <port name="a" combinational_sink_ports="out"/>
        <port name="b" combinational_sink_ports="out"/>
      </input_ports>
      <output_ports>
        <port name="out"/>
      </output_ports>
    </model>
    <model name="dpram_128x8">
      <input_ports>
        <port name="clk" is_clock="1"/>
        <port name="we" clock="clk"/>
        <port name="waddr" clock="clk"/>
        <port name="din" clock="clk"/>
        <port name="raddr" clock="clk"/>
      </input_ports>
      <output_ports>
        <port name="dout" clock="clk"/>
      </output_ports>
    </model>
    <model name="pcie">
      <input_ports>
        <port name="clk" is_clock="1"/>
        <port name="rst" clock="clk"/>
        <port name="rx" clock="clk"/>
      </input_ports>
      <output_ports>
        <port name="tx" clock="clk"/>
        <port name="link_up" clock="clk"/>
      </output_ports>
    </model>
    <model name="odd-name">
      <input_ports>
        <port name="x"/>
      </input_ports>
      <output_ports>
        <port name="y"/>
      </output_ports>
    </model>
  </models>
  <complexblocklist>
    <pb_type name="mult">
      <input name="in" num_pins="16"/>
      <output name="o" num_pins="16"/>
      <pb_type name="m8" blif_model=".subckt mult_8" num_pb="1">
        <input name="a" num_pins="8"/>
        <input name="b" num_pins="8"/>
        <output name="out" num_pins="16"/>
      </pb_type>
    </pb_type>
    <pb_type name="mem">
      <pb_type name="dp" blif_model=".subckt dpram_128x8" num_pb="1" class="memory">
        <input name="we" num_pins="1"/>
        <input name="waddr" num_pins="7"/>
        <input name="din" num_pins="8"/>
        <input name="raddr" num_pins="7"/>
        <output name="dout" num_pins="8"/>
        <clock name="clk" num_pins="1"/>
      </pb_type>
    </pb_type>
    <pb_type name="hip">
      <pb_type name="p" blif_model=".subckt pcie" num_pb="1">
        <input name="rst" num_pins="1"/>
        <input name="rx" num_pins="4"/>
        <output name="tx" num_pins="4"/>
        <output name="link_up" num_pins="1"/>
        <clock name="clk" num_pins="1"/>
      </pb_type>
    </pb_type>
    <pb_type name="odd">
      <pb_type name="o" blif_model=".subckt odd-name" num_pb="1">
        <input name="x" num_pins="1"/>
        <output name="y" num_pins="1"/>
      </pb_type>
    </pb_type>
  </complexblocklist>
</architecture>
