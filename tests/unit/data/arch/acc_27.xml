<architecture>
  <models>
    <model name="multiply">
      <input_ports><port name="a"/><port name="b"/></input_ports>
      <output_ports><port name="out"/></output_ports>
    </model>
    <model name="adder">
      <input_ports><port name="a"/><port name="b"/><port name="cin"/></input_ports>
      <output_ports><port name="cout"/><port name="sumout"/></output_ports>
    </model>
    <model name="single_port_ram">
      <input_ports>
        <port name="we" clock="clk"/><port name="addr" clock="clk"/><port name="data" clock="clk"/>
        <port name="clk" is_clock="1"/>
      </input_ports>
      <output_ports><port name="out" clock="clk"/></output_ports>
    </model>
    <model name="dual_port_ram">
      <input_ports>
        <port name="we1" clock="clk"/><port name="we2" clock="clk"/>
        <port name="addr1" clock="clk"/><port name="addr2" clock="clk"/>
        <port name="data1" clock="clk"/><port name="data2" clock="clk"/>
        <port name="clk" is_clock="1"/>
      </input_ports>
      <output_ports><port name="out1" clock="clk"/><port name="out2" clock="clk"/></output_ports>
    </model>
  </models>
  <complexblocklist>
    <pb_type name="mult">
      <pb_type name="m18" blif_model=".subckt multiply" num_pb="1">
        <input name="a" num_pins="18"/><input name="b" num_pins="18"/>
        <output name="out" num_pins="36"/>
      </pb_type>
      <pb_type name="m27" blif_model=".subckt multiply" num_pb="1">
        <input name="a" num_pins="27"/><input name="b" num_pins="27"/>
        <output name="out" num_pins="54"/>
      </pb_type>
    </pb_type>
    <pb_type name="memory">
      <pb_type name="sp9" blif_model=".subckt single_port_ram" class="memory">
        <input name="addr" num_pins="9"/><input name="data" num_pins="40"/>
        <input name="we" num_pins="1"/><output name="out" num_pins="40"/>
        <clock name="clk" num_pins="1"/>
      </pb_type>
      <pb_type name="sp11" blif_model=".subckt single_port_ram" class="memory">
        <input name="addr" num_pins="11"/><input name="data" num_pins="10"/>
        <input name="we" num_pins="1"/><output name="out" num_pins="10"/>
        <clock name="clk" num_pins="1"/>
      </pb_type>
      <pb_type name="dp10" blif_model=".subckt dual_port_ram" class="memory">
        <input name="addr1" num_pins="10"/><input name="addr2" num_pins="10"/>
        <input name="data1" num_pins="20"/><input name="data2" num_pins="20"/>
        <input name="we1" num_pins="1"/><input name="we2" num_pins="1"/>
        <output name="out1" num_pins="20"/><output name="out2" num_pins="20"/>
        <clock name="clk" num_pins="1"/>
      </pb_type>
    </pb_type>
  </complexblocklist>
</architecture>
