# The 5.4 LPM level: the 5.1 LPM script (tests/lpm/lpm.script) without its write. @LIB@ is
# lib/lpm.o3lib; @FAMILY@ is empty; @TECHLIB@ the design's own library (tests/loc/techlib.txt).
read_techlib @LIB@
@TECHLIB@
read_verilog @DESIGN@
proc
opt
wreduce
opt_clean
opt -full
lpmmap @FAMILY@
opt_clean
opt -full
