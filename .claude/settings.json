{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "../golden",
      "../work",
      "../external"
    ],
    "allow": [
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(ninja *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git -C ~/odin3-ws/golden add *)",
      "Bash(git -C ~/odin3-ws/golden commit *)",
      "Bash(git -C ~/odin3-ws/golden push *)",
      "Bash(git -C ~/odin3-ws/golden lfs *)",
      "Bash(git -C ~/odin3-ws/golden status *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(./tools/*)",
      "Bash(tools/*)",
      "Bash(python3 -m unittest *)",
      "Bash(lizard *)",
      "Bash(clang-tidy *)",
      "Bash(clang-format *)",
      "Bash(rm -rf /tmp/claude-1000/*)",
      "Bash(rm -rf /home/jamiespa/odin3-ws/work/*)",
      "Bash(rm -rf ~/odin3-ws/work/*)",
      "Bash(rm -rf /home/jamiespa/odin3-ws/rt-run*)",
      "Bash(rm -rf ~/odin3-ws/rt-run*)",
      "Bash(rm -fr /tmp/claude-1000/*)",
      "Bash(rm -fr /home/jamiespa/odin3-ws/work/*)",
      "Bash(rm -fr ~/odin3-ws/work/*)",
      "Bash(rm -fr /home/jamiespa/odin3-ws/rt-run*)",
      "Bash(rm -fr ~/odin3-ws/rt-run*)",
      "Bash(rm -r /tmp/claude-1000/*)",
      "Bash(rm -r /home/jamiespa/odin3-ws/work/*)",
      "Bash(rm -r ~/odin3-ws/work/*)",
      "Bash(rm -r /home/jamiespa/odin3-ws/rt-run*)",
      "Bash(rm -r ~/odin3-ws/rt-run*)",
      "Bash(rm -f /tmp/claude-1000/*)",
      "Bash(rm -f /home/jamiespa/odin3-ws/work/*)",
      "Bash(rm -f ~/odin3-ws/work/*)",
      "Bash(rm -f /home/jamiespa/odin3-ws/rt-run*)",
      "Bash(rm -f ~/odin3-ws/rt-run*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git reset --hard *)",
      "Bash(rm * * *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(~/odin3-ws/external/**)",
      "Bash(rm *..*)",
      "Bash(rm * /)",
      "Bash(rm * / *)",
      "Bash(rm * ~)",
      "Bash(rm * ~/)",
      "Bash(rm * ~ *)",
      "Bash(rm * ~/ *)",
      "Bash(rm * /home/jamiespa)",
      "Bash(rm * /home/jamiespa/)",
      "Bash(rm * /home/jamiespa *)",
      "Bash(rm * /home/jamiespa/ *)",
      "Bash(rm *odin3-ws/external*)",
      "Bash(rm *odin3-ws/golden*)",
      "Bash(rm *ODIN_III_DATA*)",
      "Bash(rm *.git)",
      "Bash(rm *.git/*)",
      "Bash(rm *.git *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "~/odin3-ws/golden",
        "~/odin3-ws/work",
        "~/.cache/ccache"
      ],
      "denyWrite": [
        "~/odin3-ws/external"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "lfs.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */third_party/*) ;; *.c|*.h) clang-format -i \"$f\" ;; esac; true"
          }
        ]
      }
    ]
  }
}
