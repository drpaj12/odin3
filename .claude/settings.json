{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": ["~/odin3-ws/golden", "~/odin3-ws/work", "~/odin3-ws/external"],
    "allow": [
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(ninja *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git -C *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(./tools/*)",
      "Bash(tools/*)",
      "Bash(python3 -m unittest *)",
      "Bash(lizard *)",
      "Bash(clang-tidy *)",
      "Bash(clang-format *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(~/odin3-ws/external/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["~/odin3-ws/golden", "~/odin3-ws/work", "~/.cache/ccache"],
      "denyWrite": ["~/odin3-ws/external"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "lfs.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */third_party/*) ;; *.c|*.h) clang-format -i \"$f\" ;; esac; true"
          }
        ]
      }
    ]
  }
}
