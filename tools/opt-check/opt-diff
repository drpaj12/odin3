#!/usr/bin/env bash
# opt-diff: Odin III opt against Yosys 0.55 on the same input (2F spec 20.3, Task 17). See opt_diff.py.
# Exit codes: 0 no unexpected difference, 1 a difference, 2 error or usage, 77 skipped (no memory cap).
set -euo pipefail
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
export PYTHONPATH="$here/../elab-check${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$here/opt_diff.py" "$@"
