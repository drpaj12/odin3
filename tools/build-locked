#!/usr/bin/env bash
# build-locked: `cmake --build` that never overlaps a heavy run (2E plan point (p), ruling C1).
#
# Usage: tools/build-locked <cmake --build args...>   e.g. tools/build-locked --preset debug -j4
#
# - Refused (exit 2) inside a heavy run (ODIN3_HEAVY_SLICE set, and this process in that slice and
#   holding the heavy lock, as heavy-run checks): its shared lock would wait forever on the heavy
#   run's exclusive one. A stale ODIN3_HEAVY_SLICE is ignored with a warning.
# - Writer preference: while any $DIR/odin3-heavy.queued.<pid> names a live tools/heavy-run (one
#   waiting for the lock), it waits, so a stream of overlapping builds cannot starve a queued
#   heavy job. A flag whose PID is dead, or is now another program (a reused PID after a
#   heavy-run was SIGKILLed), is stale: it is removed and ignored.
# - Then it takes $DIR/odin3-heavy.lock shared: builds share it with each other and exclude a
#   heavy run, which takes it exclusively. When a heavy run holds it, it says so before waiting,
#   then runs `exec flock -s $DIR/odin3-heavy.lock cmake --build <args>`; exits with cmake's status.
#
# DIR is /tmp/claude-1000 (ODIN3_HEAVY_DIR overrides it, for the tests only); the flags are polled
# every ODIN3_HEAVY_POLL seconds (default 5).
set -uo pipefail

dir=${ODIN3_HEAVY_DIR:-/tmp/claude-1000}
lock=$dir/odin3-heavy.lock

# True when this shell really runs inside a heavy run: its cgroup is under the slice
# $ODIN3_HEAVY_SLICE names, and one of its descriptors (fd 9, inherited from heavy-run) holds the
# heavy lock. The variable alone is not evidence: one leaked into another environment must not
# run a job uncapped and unlocked. ODIN3_HEAVY_CGROUP replaces /proc/self/cgroup (tests only).
inside_heavy_run() {
    local cgroup fd want
    cgroup=$(cat "${ODIN3_HEAVY_CGROUP:-/proc/self/cgroup}" 2>/dev/null) || return 1
    [[ $cgroup == */"$ODIN3_HEAVY_SLICE"/* ]] || return 1
    want=$(readlink -f "$lock" 2>/dev/null) || return 1
    for fd in /proc/$$/fd/*; do
        [[ $(readlink "$fd" 2>/dev/null) == "$want" ]] && return 0
    done
    return 1
}

if [[ -n ${ODIN3_HEAVY_SLICE:-} ]]; then
    if inside_heavy_run; then
        echo "build-locked: refused inside a heavy run ($ODIN3_HEAVY_SLICE): the build would" \
            "wait forever on the heavy lock; build before starting the heavy run" >&2
        exit 2
    fi
    echo "build-locked: warning: ODIN3_HEAVY_SLICE=$ODIN3_HEAVY_SLICE is set outside a heavy" \
        "run (not in that slice, or no heavy lock held); ignoring it" >&2
    unset ODIN3_HEAVY_SLICE
fi
poll=${ODIN3_HEAVY_POLL:-5}
mkdir -p "$dir" || exit 2

# True when pid is a running tools/heavy-run.
is_heavy_run() {
    local cmdline
    [[ $1 =~ ^[0-9]+$ ]] || return 1
    cmdline=$(tr '\0' ' ' 2>/dev/null <"/proc/$1/cmdline") || return 1
    [[ $cmdline == *heavy-run* ]]
}

# The PID of the first queued heavy run that is still alive, or nothing; stale flags are removed.
queued_pid() {
    local flag pid
    for flag in "$dir"/odin3-heavy.queued.*; do
        [[ -e $flag ]] || continue
        pid=${flag##*.}
        if is_heavy_run "$pid"; then
            echo "$pid"
            return
        fi
        rm -f "$flag"
    done
}

said=0
while pid=$(queued_pid) && [[ -n $pid ]]; do
    if [[ $said -eq 0 ]]; then
        echo "build-locked: waiting for queued heavy run $pid" >&2
        said=1
    fi
    sleep "$poll"
done
if ! flock -s -n "$lock" true; then
    echo "build-locked: waiting for the heavy run that holds $lock" >&2
fi
exec flock -s "$lock" cmake --build "$@"
