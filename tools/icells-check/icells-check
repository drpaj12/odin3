#!/usr/bin/env bash
# icells-check: Verilog written at the word, gate, LUT or LPM level reads back with
# `read_verilog -icells` equivalent to what was written (5.2 spec section 7). Exit codes: 0 every
# design passes; 1 a leg failed; 2 usage or tool error; 3 a child crashed or timed out; 4 unproven
# (a proof hit its size limit or Yosys has no model of a cell); 77 skipped (no memory cap). See
# icells_check.py.
set -euo pipefail
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
export PYTHONPATH="$here:$here/../elab-check:$here/../opt-check${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$here/icells_check.py" "$@"
