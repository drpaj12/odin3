#!/usr/bin/env bash
# run-reject: the Verilog negative cases (tests/verilog/reject, reject-2d, ignore-2d). See run_reject.py.
# Exit codes: 0 pass, 1 a case failed, 2 usage/input error, 77 (--elaborate) every case pending.
set -euo pipefail
exec python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/run_reject.py" "$@"
