#!/usr/bin/env bash
# tier3: identity tier 3 (4.2 spec T-2), the heavy run: the baseline binary's `hardmap` against the
# candidate binary's `partial_map` over the 33 designs of tests/partial_map/identity_inputs.txt and
# the 19 VTR designs of tests/hardmap/vtr_designs.txt (smallest first). Needs VTR_ROOT and the
# Parmys goldens (for the tops of the 19). Run it through tools/heavy-run, lanes idle:
#   tools/heavy-run tools/partial-map-check/tier3 BASELINE_ODIN3 CANDIDATE_ODIN3
# Exit codes are identity's.
set -euo pipefail
if [ "$#" -ne 2 ]; then
    echo "usage: tier3 BASELINE_ODIN3 CANDIDATE_ODIN3" >&2
    exit 2
fi
: "${VTR_ROOT:?VTR_ROOT must name the VTR checkout}"
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
repo="$here/../.."
exec "$here/identity" --tier 3 --baseline "$1" --candidate "$2" \
    --list "$repo/tests/partial_map/identity_inputs.txt" \
    --vtr-list "$repo/tests/hardmap/vtr_designs.txt" \
    --vtr-root "$VTR_ROOT/vtr_flow/benchmarks/verilog" --min-ok 25
