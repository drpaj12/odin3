# vtr-qor nightly (3H spec 13). Peter installs these files; no agent does.
#   mkdir -p ~/.config/systemd/user
#   cp tools/vtr-qor/systemd/odin3-vtr-qor-nightly.* ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now odin3-vtr-qor-nightly.timer
# Remove with: systemctl --user disable --now odin3-vtr-qor-nightly.timer
[Unit]
Description=vtr-qor nightly QoR run (heavy; holds the heavy lock until about 06:00)

[Service]
Type=exec
Environment=ODIN3_HEAVY_OK=1
# Hard stop (5 h budget + 30 min grace): a hung tool must not hold the heavy lock past the night.
RuntimeMaxSec=19800
ExecStart=%h/odin3-ws/odin3/tools/heavy-run %h/odin3-ws/odin3/tools/vtr-qor/vtr-qor nightly
