#!/usr/bin/env bash
# write-corrupt: odin3-write wrapper for the negative CTests. WC_REAL_WRITE names the real driver;
# arguments are those of odin3-write. WC_CORRUPT picks the damage:
#   logic (default)  one JSON LUT bit flipped and one Verilog `&` made `|`: the JSON and the
#                    equivalence gates must fail;
#   bbox             the Verilog top instantiates an extra black box: equiv-check's
#                    "unsupported black box" is then located in the Yosys netlist, not in the
#                    golden, and must count as an error, not an exclusion.
set -euo pipefail
"${WC_REAL_WRITE:?}" "$@"
json="" vlog=""
while [ $# -gt 0 ]; do
    case $1 in
    --json) json=$2; shift 2 ;;
    --verilog) vlog=$2; shift 2 ;;
    *) shift ;;
    esac
done
case ${WC_CORRUPT:-logic} in
logic)
    [ -z "$json" ] || sed -i '0,/"LUT": "\([01]*\)0"/s//"LUT": "\11"/' "$json"
    [ -z "$vlog" ] || sed -i '0,/^\(  assign .*\) & /s//\1 | /' "$vlog"
    ;;
bbox)
    if [ -n "$vlog" ]; then
        sed -i '0,/^endmodule$/s//  (* keep *) wc_injected_bb wc_injected (.a(1'"'"'b0));\nendmodule/' "$vlog"
        printf '\n(* blackbox *)\nmodule wc_injected_bb (\n  input a\n);\nendmodule\n' >>"$vlog"
    fi
    ;;
esac
