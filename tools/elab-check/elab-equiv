#!/usr/bin/env bash
# elab-equiv: 2D's elaboration against Yosys 0.55's on one Verilog file. See elab_equiv.py.
# Exit codes: 0 equivalent, 1 not equivalent, 2 error, 3 oracle crash (Yosys died of a signal),
# 77 skipped (no memory cap possible).
set -euo pipefail
exec python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/elab_equiv.py" "$@"
